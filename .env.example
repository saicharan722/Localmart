# Leaflet with OpenStreetMap tiles and OSRM routing does not need a map API key.
# Identify your installation when calling public Nominatim (provide a monitored contact).
# Configure an identifying app name and real contact email for Nominatim.
# NOMINATIM_USER_AGENT=LocalMart/1.0 (contact: your-email@example.com)

# PostgreSQL database connection. Put the local password in .env, never in source control.
DB_NAME=localmart
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Razorpay test/live keys and the webhook signing secret configured in Razorpay.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Location type-ahead provider; the Photon demo can be replaced with a hosted/self-hosted endpoint.
LOCATION_SEARCH_API_URL=https://photon.komoot.io/api/

# LocalMart delivery is free.
LOCALMART_DELIVERY_CHARGE=0.00
# Use allocated when delivery is incidental to the goods supply; use excluded
# when LocalMart bills it as a separately treated delivery service.
LOCALMART_DELIVERY_GST_MODE=allocated

# Delivery partner earnings are recorded when an order is delivered.
DELIVERY_PARTNER_EARNING_PERCENT=10.00

# Merchant password-reset mail. Use a Gmail App Password, not your account password.
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_HOST=smtp.gmail.com
#EMAIL_PORT=587
#EMAIL_USE_TLS=True
#EMAIL_HOST_USER=your-mailbox@example.com
#EMAIL_HOST_PASSWORD=your-gmail-app-password
#DEFAULT_FROM_EMAIL="LocalMart <your-mailbox@example.com>"
#PASSWORD_RESET_TIMEOUT=3600

# Local development can print reset links in the Django terminal instead:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
